// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Link {
  id          Int      @id @default(autoincrement())
  url         String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("links")
}

model MenuSnapshot {
  version Int @id @default(autoincrement())
  checksum String
  items Json
  createdAt DateTime @default(now())
}
model CheckoutQuote {
  id String @id @default(uuid())
  menuVersion Int
  items Json
  total Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  payment Payment?
}
model Payment {
  id String @id
  quoteId String @unique
  quote CheckoutQuote @relation(fields: [quoteId], references: [id])
  status String
  providerStatus String
  amount Int
  order KioskOrder?
  createdAt DateTime @default(now())
}
model KioskEvent {
  id String @id
  payload Json
  createdAt DateTime @default(now())
}

model KioskOrder {
  id String @id @default(uuid())
  paymentId String @unique
  payment Payment @relation(fields: [paymentId], references: [id])
  total Int
  items Json
  createdAt DateTime @default(now())
}
